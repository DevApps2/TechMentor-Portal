# Copie para .env.local e ajuste. O Vite so le este arquivo ao iniciar (reinicie o npm run dev).
# Endereco da API do TechMentor, terminando em /techmentor/api (sem barra no fim).
# Na Vercel, esta mesma variavel vai em Settings > Environment Variables.
VITE_API_URL=http://localhost:8080/techmentor/api
